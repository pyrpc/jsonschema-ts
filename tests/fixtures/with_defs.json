{
  "title": "Blog",
  "type": "object",
  "properties": {
    "posts": {
      "type": "array",
      "items": {"$ref": "#/$defs/Post"}
    }
  },
  "required": ["posts"],
  "$defs": {
    "Post": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "body": {"type": "string"},
        "author": {"$ref": "#/$defs/Author"}
      },
      "required": ["title", "body", "author"]
    },
    "Author": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "email": {"type": "string"}
      },
      "required": ["name", "email"]
    }
  }
}
